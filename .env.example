# Telegram Bot Integration Environment Variables
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ALLOWED_CHAT_IDS=
OPENCLAW_WORKSPACE_ROOT=
NODE_ENV=development

# Optional developer variable (forces unrestricted access in non-production environments if set to true)
TELEGRAM_ALLOW_UNRESTRICTED_DEV_MODE=false

# Google Drive Publisher Variables
GOOGLE_DRIVE_PUBLISH_MODE=local
GOOGLE_DRIVE_LOCAL_ROOT=
GOOGLE_DRIVE_OUTPUT_FOLDER_ID=
GOOGLE_DRIVE_CREDENTIALS_BASE64=
GOOGLE_DRIVE_CREDENTIALS=
GOOGLE_DRIVE_ALLOW_INTERNAL_DOC_PUBLISH=false
