# Cresca OS - Environment Variables Example

# System
PORT=3000
NODE_ENV=development

# Postgres (Source of Truth)
DATABASE_URL=postgres://user:password@localhost:5432/cresca_os

# Supabase (Auth & Realtime)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Integrations
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id
ENABLE_EVENT_LOOP=false

GOOGLE_PLACES_API_KEY=
OPENAI_API_KEY=
MANUS_AI_API_KEY=

# GHL (CRM Execution)
GHL_API_KEY=
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=

# Airtable (Visual Ops)
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=
